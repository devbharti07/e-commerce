# Database Configuration (PostgreSQL running in Docker or Managed Cloud Provider)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jagdamba_mobile?schema=public"

# Optional Docker Compose Overrides for local dev
POSTGRES_USER="USER"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DB="jagdamba_mobile"
POSTGRES_PORT=5432

# JWT Secret for Session Cookies
JWT_SECRET="replace_with_secure_random_string_in_production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps API Key for Address Autocomplete and Map Picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
